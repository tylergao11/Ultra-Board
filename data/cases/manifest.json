{
  "schema_version": 1,
  "record_glob": "data/cases/records/*.json",
  "record_template": "data/cases/case_template.json",
  "default_retrieval_status": [
    "accepted"
  ],
  "allowed_case_statuses": [
    "open",
    "closed"
  ],
  "allowed_retrieval_statuses": [
    "accepted",
    "hypothesis",
    "superseded"
  ],
  "allowed_decision_record_modes": [
    "contemporaneous",
    "blind_reconstruction"
  ],
  "allowed_historical_replay_scopes": [
    "contemporaneous_evidence",
    "current_method_only"
  ],
  "allowed_models": [
    "offense",
    "defense",
    "offense_primary_defense_backup",
    "no_effective_defense",
    "undetermined"
  ],
  "allowed_trade_results": [
    "no_trade",
    "sealed_limit",
    "failed_to_hold_limit",
    "pending",
    "not_applicable"
  ],
  "allowed_selection_modes": [
    "unique",
    "conditional",
    "none"
  ],
  "allowed_source_kinds": [
    "native_structured"
  ],
  "condition_axes": [
    "fermentation",
    "acceleration",
    "board_shape",
    "height_environment"
  ],
  "result_only_tags": [
    "无交易",
    "打板成功",
    "打板吃面",
    "未触板",
    "触板未封住",
    "收盘封住",
    "T+2高开",
    "T+2低开",
    "T+2反包"
  ],
  "retrieval_text_max_chars": 480,
  "truth_policy": "每个 JSON 记录是该案例版本的唯一真相源；Markdown 阅读稿、RAG 切片、embedding 与向量索引均为可重建派生物。",
  "retrieval_policy": "先按时间、状态和结构字段过滤，再使用仅含 T 日条件与冻结决策的 retrieval_text 做语义召回；结果字段不参与相似度输入。",
  "encoding": "UTF-8 without BOM"
}
